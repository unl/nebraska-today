<hr class="custom-l-line dcf-mt-0">
<div class="dcf-d-flex dcf-ai-center">
  <h2 class="dcf-txt-sm dcf-regular dcf-uppercase unl-ls-1">Recent News</h2>
</div>
<div class="dcf-d-grid dcf-grid-cols-1 dcf-grid-cols-2@md dcf-grid-cols-4@lg dcf-col-gap-vw dcf-row-gap-6">
  {% for row in rows %}
    {%
      set row_classes = [
        default_row_class ? 'views-row dcf-col ',
      ]
    %}
    <div{{ row.attributes.addClass(row_classes) }}>
      {{- row.content -}}
    </div>
  {% endfor %}
</div>
