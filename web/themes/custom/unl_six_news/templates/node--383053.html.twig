{# Template for /subscribe #}

<article{{ attributes }}>

  {{ title_prefix }}
  {% if label and not page %}
    <h2{{ title_attributes }}>
      <a href="{{ url }}" rel="bookmark">{{ label }}</a>
    </h2>
  {% endif %}
  {{ title_suffix }}

  {% if display_submitted %}
    <footer>
      {{ author_picture }}
      <div{{ author_attributes }}>
        {% trans %}Submitted by {{ author_name }} on {{ date }}{% endtrans %}
        {{ metadata }}
      </div>
    </footer>
  {% endif %}

  <div{{ content_attributes }}>
    <div class="dcf-grid dcf-col-gap-vw dcf-row-gap-5">
      <div class="dcf-col-100% dcf-col-50%-start@md">
        <h2>Nebraska Today</h2>
        <p><a href="https://mailman.unl.edu/mailman3/lists/today_subscribers.lists.nebraska.edu/">Follow this link to subscribe to Nebraska Today</a></p>
        <p>Note: If you have a University of Nebraska–Lincoln faculty or staff role, you already receive the Nebraska Today email automatically!</p>
      </div>
      <div class="dcf-col-100% dcf-col-50%-end@md">
        <h2>IANR News Now</h2>
        <div class="_form_1">
          <form method="POST" action="https://unl233.activehosted.com/proc.php" id="_form_6A0350BA05F53_" class="dcf-form" novalidate="" data-styles-version="5">
            <input type="hidden" name="u" value="6A0350BA05F53" data-name="u">
            <input type="hidden" name="f" value="1" data-name="f">
            <input type="hidden" name="s" data-name="s">
            <input type="hidden" name="c" value="0" data-name="c">
            <input type="hidden" name="m" value="0" data-name="m">
            <input type="hidden" name="act" value="sub" data-name="act">
            <input type="hidden" name="v" value="2" data-name="v">
            <input type="hidden" name="or" value="2672c06e-95ab-4521-a577-7b9887697b52" data-name="or">
            <div class="_form-content">
              <div class="_form_element _x97249702 _full_width _clear">
                <h3 class="_form-title dcf-sr-only">Subscribe to IANR News Now</h3>
              </div>
              <div class="_form_element _x39706375 _full_width _clear">
                <div class="_html-code"><p>Complete the form below to subscribe to the IANR News Now weekly email newsletter.</p></div>
              </div>
              <div class="_form_element _x60041001 _full_width ">
                <label for="email" class="_form-label">
                  Email<span class="field-required dcf-required">required</span>                                    </label>
                <div class="_field-wrapper">
                  <input type="text" id="email" name="email" placeholder="Type your email" required="" data-name="email">
                </div>
              </div>
              <div class="_form_element _x30404405 _full_width ">
                <label for="firstname" class="_form-label">
                  First Name                                    </label>
                <div class="_field-wrapper">
                  <input type="text" id="firstname" name="firstname" placeholder="Type your first name" data-name="firstname">
                </div>
              </div>
              <div class="_form_element _x18786584 _full_width ">
                <label for="lastname" class="_form-label">
                  Last Name                                    </label>
                <div class="_field-wrapper">
                  <input type="text" id="lastname" name="lastname" placeholder="Type your last name" data-name="lastname">
                </div>
              </div>

              <div class="_button-wrapper _full_width">
                <button id="_form_1_submit" class="_submit dcf-btn dcf-btn-primary dcf-mt-4" type="submit">Submit</button>
              </div>
              <div class="_clear-element"></div>
            </div>
            <div class="_form-thank-you" style="display:none;"></div>
          </form>
        </div>
        {#
        <div class="_form_1"></div>
        <script src="https://unl233.activehosted.com/f/embed.php?id=1" type="text/javascript" charset="utf-8"></script>
        #}
      </div>
    </div>
  </div>

</article>
